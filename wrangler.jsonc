// Box Office: one analytics loader + first-party PostHog relay for every app. See AGENTS.md.
{
  "name": "box-office",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-01",
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": true, "head_sampling_rate": 1 },
  "services": [{ "binding": "CAST", "service": "cast-list" }],
  // Per truncated-IP (/24 or /48) ceiling on relay posts. Over it, events are dropped with a 200 (never break a page).
  "ratelimits": [{ "name": "RATE", "namespace_id": "4201", "simple": { "limit": 600, "period": 60 } }],
  // One data point per request: route, outcome, app, method, country, colo, version | status, ms, upstream ms, bytes.
  // Analytics Engine was enabled on the account on 2026-11-18. The code skips metrics if the binding is missing.
  "analytics_engine_datasets": [{ "binding": "METRICS", "dataset": "box_office" }],
  "vars": { "VERSION": "dev" },
  "routes": [
    { "pattern": "mutaafaziz.com/boxoffice/*", "zone_name": "mutaafaziz.com" }
  ]
}
